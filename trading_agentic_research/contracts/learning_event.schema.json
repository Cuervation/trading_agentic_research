{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningEvent",
  "type": "object",
  "required": ["learning_id", "hypothesis_id", "family", "run_id", "decision", "flags", "written_to_learning_memory"],
  "properties": {
    "learning_id": {"type": "string", "minLength": 1},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "enum": ["rejected", "accepted_for_followup", "promoted_candidate"]},
    "flags": {"type": "array", "items": {"type": "string"}},
    "written_to_learning_memory": {"type": "boolean"},
    "can_promote_baseline": {"type": "boolean"}
  },
  "additionalProperties": true
}
